---
import { monthYear, monthYearNum } from '../lib';
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ul class="rows">
  {posts.map((p: any) => {
    const end = p.data.endDate ?? p.data.date;
    return (
      <li class="row reveal">
        <a href={`${base}/blog/${p.id}`}>
          <span class="row-title">{p.data.title}{p.data.tag && <span class="row-tag"> · {p.data.tag}</span>}</span>
          <span class="row-date">
            <span class="d">{monthYear(p.data.date)} - {monthYear(end)}</span>
            <span class="m">{monthYearNum(p.data.date)} - {monthYearNum(end)}</span>
          </span>
        </a>
      </li>
    );
  })}
</ul>
